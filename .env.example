# ──────────────────────────────────────────────────────────────
#  Our Story — server settings
#  Copy this file to `.env` and change ADMIN_KEY. That is all.
# ──────────────────────────────────────────────────────────────

# The password for /admin. Change it — it is the only lock on the console.
ADMIN_KEY=amour-2026

# Where the API listens.
PORT=4000

# Where the site itself lives (used only for the links printed at boot).
CLIENT_URL=http://localhost:5173

# How big one file may be, in megabytes.
MAX_PHOTO_MB=15
MAX_VIDEO_MB=150
MAX_AUDIO_MB=25
